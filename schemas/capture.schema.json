{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/capture/v1",
  "title": "Bubblevan Capture",
  "type": "object",
  "required": [
    "capture_id",
    "created_at",
    "source_agent",
    "source_platform",
    "source_channel",
    "source_message_id",
    "type_hint",
    "text",
    "urls",
    "project_hint",
    "topics",
    "visibility",
    "dedupe_key",
    "content_sha256",
    "status",
    "raw"
  ],
  "properties": {
    "capture_id": { "type": "string", "pattern": "^cap-" },
    "created_at": { "type": "string" },
    "source_agent": { "type": "string" },
    "source_platform": { "type": "string" },
    "source_channel": { "type": "string" },
    "source_message_id": { "type": "string" },
    "type_hint": {
      "type": "string",
      "enum": ["link", "bookmark", "task", "event", "project_log", "note"]
    },
    "text": { "type": "string" },
    "urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "project_hint": { "type": "string" },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public"]
    },
    "dedupe_key": { "type": "string" },
    "content_sha256": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["new", "duplicate", "processed", "rejected"]
    },
    "duplicate_of": { "type": "string" },
    "raw": {
      "type": "object",
      "required": ["original_text"],
      "properties": {
        "original_text": { "type": "string" },
        "payload": {}
      }
    }
  },
  "additionalProperties": true
}

