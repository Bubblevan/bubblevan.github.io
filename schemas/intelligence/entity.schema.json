{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/intelligence-entity/v1",
  "title": "Research Intelligence Entity",
  "type": "object",
  "required": ["schema", "entity_id", "entity_type", "name", "aliases", "urls", "external_ids", "topics", "relations"],
  "properties": {
    "schema": { "const": "bubblevan/intelligence-entity/v1" },
    "entity_id": { "type": "string", "pattern": "^ent-[0-9a-f]{24}$" },
    "entity_type": { "type": "string", "enum": ["person", "organization", "lab", "venue", "model", "dataset", "repository", "project"] },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "urls": { "type": "array", "items": { "type": "string" } },
    "external_ids": { "type": "object" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target_id"],
        "properties": {
          "predicate": { "type": "string", "minLength": 1 },
          "target_id": { "type": "string", "pattern": "^(src|obs|art|ent|topic)-" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
