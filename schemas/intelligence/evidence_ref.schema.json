{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/evidence-ref/v1",
  "title": "Immutable Research Evidence Reference",
  "type": "object",
  "required": ["schema", "evidence_id", "artifact_id", "observation_id", "source_id", "canonical_url", "locator", "text", "text_sha256", "evidence_type", "retrieved_at"],
  "properties": {
    "schema": {"const": "bubblevan/evidence-ref/v1"},
    "evidence_id": {"type": "string", "pattern": "^ev-[0-9a-f]{24}$"},
    "artifact_id": {"type": "string", "pattern": "^art-[0-9a-f]{24}$"},
    "observation_id": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"]},
    "locator": {
      "type": "object", "required": ["type", "value"],
      "properties": {"type": {"type": "string", "enum": ["page", "section", "observation", "metadata", "paper_page"]}, "value": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 80000},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_type": {"type": "string", "enum": ["primary_text", "observation_text", "explicit_provider_metadata", "paper_full_text"]},
    "retrieved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
