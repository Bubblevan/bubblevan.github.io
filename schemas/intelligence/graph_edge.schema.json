{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/intelligence-graph-edge/v1",
  "title": "Research Intelligence Graph Edge",
  "type": "object",
  "required": ["schema", "edge_id", "subject_id", "predicate", "object_id", "first_observed_at", "last_observed_at", "evidence"],
  "properties": {
    "schema": { "const": "bubblevan/intelligence-graph-edge/v1" },
    "edge_id": { "type": "string", "pattern": "^edge-[0-9a-f]{24}$" },
    "subject_id": { "type": "string", "pattern": "^(src|obs|art|ent|topic)-[a-z0-9-]+$" },
    "predicate": { "type": "string", "minLength": 1 },
    "object_id": { "type": "string", "pattern": "^(src|obs|art|ent|topic)-[a-z0-9-]+$" },
    "first_observed_at": { "type": "string", "format": "date-time" },
    "last_observed_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_type", "confidence", "observed_at"],
        "properties": {
          "evidence_type": { "type": "string", "enum": ["exact_provider_metadata", "explicit_source_link", "explicit_observation_text", "image_extract", "inferred_candidate"] },
          "provider": { "type": ["string", "null"] },
          "source_id": { "type": ["string", "null"], "pattern": "^(src-[0-9a-f]{24})?$" },
          "observation_id": { "type": ["string", "null"], "pattern": "^(obs-[0-9a-f]{24})?$" },
          "provider_record_id": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "observed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
