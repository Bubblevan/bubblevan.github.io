{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/intelligence-retrieval-benchmark/v1",
  "title": "Frozen Retrieval Benchmark",
  "type": "object",
  "required": ["schema", "version", "split", "corpus_hash", "queries", "benchmark_hash"],
  "properties": {
    "schema": { "const": "bubblevan/intelligence-retrieval-benchmark/v1" },
    "version": { "type": "string", "minLength": 1 },
    "split": { "type": "string", "enum": ["synthetic", "dev", "holdout", "draft"] },
    "corpus_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "queries": { "type": "array", "items": { "type": "object", "required": ["query_id", "query", "as_of", "qrels", "provenance"], "properties": { "query_id": { "type": "string", "minLength": 1 }, "query": { "type": "string" }, "as_of": { "type": ["string", "null"], "format": "date-time" }, "seed_artifact_ids": { "type": "array", "items": { "type": "string" } }, "topic_ids": { "type": "array", "items": { "type": "string" } }, "source_ids": { "type": "array", "items": { "type": "string" } }, "qrels": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 } }, "provenance": { "type": "object", "required": ["label_source"], "properties": { "label_source": { "type": "string", "enum": ["human", "model", "synthetic_fixture", "draft"] }, "reviewed_by": { "type": ["string", "null"] }, "reviewed_at": { "type": ["string", "null"], "format": "date-time" }, "judge_type": { "type": ["string", "null"], "enum": ["human", "model", null] }, "judge_model": { "type": ["string", "null"] }, "guideline_version": { "type": ["string", "null"] }, "prompt_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false } }, "additionalProperties": false } },
    "additionalProperties": false
  },
  "additionalProperties": false
}
