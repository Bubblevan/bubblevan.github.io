{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/intelligence-source/v1",
  "title": "Research Intelligence Source",
  "type": "object",
  "required": [
    "schema",
    "source_id",
    "source_type",
    "platform",
    "name",
    "canonical_url",
    "external_ids",
    "topics",
    "acquisition",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "bubblevan/intelligence-source/v1" },
    "source_id": { "type": "string", "pattern": "^src-[0-9a-f]{24}$" },
    "source_type": {
      "type": "string",
      "enum": ["curator", "author", "lab", "publication", "feed", "community", "platform", "repository"]
    },
    "platform": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string" },
    "external_ids": { "type": "object" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "acquisition": {
      "type": "object",
      "required": ["connector", "mode"],
      "properties": {
        "connector": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["browser", "rss", "api", "html", "manual"] },
        "artifact_policy": {
          "type": "object",
          "properties": { "primary_type": { "type": "string", "enum": ["paper", "blog", "technical_report"] } },
          "additionalProperties": false
        },
        "via": { "type": "string", "enum": ["rsshub"] },
        "venue": { "type": "object" },
        "query": { "type": "object" }
      },
      "additionalProperties": false
    },
    "status": { "type": "string", "enum": ["active", "paused", "candidate", "rejected"] },
    "operations": {
      "type": "object",
      "properties": {
        "poll_sla_hours": { "type": "number", "minimum": 1, "maximum": 8760 },
        "acquisition_mode": { "type": "string", "enum": ["scheduled", "interactive", "manual"] }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
