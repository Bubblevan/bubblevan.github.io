{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/intelligence-topic/v1",
  "title": "Research Intelligence Topic",
  "type": "object",
  "required": ["schema", "topic_id", "name", "description", "parents", "aliases"],
  "properties": {
    "schema": { "const": "bubblevan/intelligence-topic/v1" },
    "topic_id": { "type": "string", "pattern": "^topic-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "parents": { "type": "array", "items": { "type": "string", "pattern": "^topic-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "aliases": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
