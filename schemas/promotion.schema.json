{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/promotion/v1",
  "title": "Bubblevan Promotion Candidate",
  "type": "object",
  "required": [
    "capture_id",
    "candidate_action",
    "target_area",
    "requires_confirmation"
  ],
  "properties": {
    "capture_id": { "type": "string" },
    "candidate_action": { "type": "string" },
    "target_area": {
      "type": "string",
      "enum": ["dashboard", "bookmark", "source", "project", "blog", "docs", "raw"]
    },
    "target_path": { "type": "string" },
    "requires_confirmation": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}

