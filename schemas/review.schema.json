{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bubblevan/review/v1",
  "title": "Bubblevan Capture Review Queue",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "capture_id",
      "created_at",
      "type_hint",
      "text",
      "status",
      "candidate_action"
    ],
    "properties": {
      "capture_id": { "type": "string" },
      "created_at": { "type": "string" },
      "type_hint": { "type": "string" },
      "text": { "type": "string" },
      "status": { "type": "string" },
      "candidate_action": { "type": "string" },
      "urls": {
        "type": "array",
        "items": { "type": "string" }
      },
      "topics": {
        "type": "array",
        "items": { "type": "string" }
      },
      "project_hint": { "type": "string" },
      "source_agent": { "type": "string" },
      "source_channel": { "type": "string" }
    },
    "additionalProperties": true
  }
}

